  "item": [
    {
      "name": "Setup - User and Event",
      "item": [
        {
          "name": "Create user (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Accept both 201 (created) and 409 (already exists)",
                  "pm.test(\"Status code is 201 or 409\", function () {",
                  "    pm.expect(pm.response.code === 201 || pm.response.code === 409).to.be.true;",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    // New user created, save id from response",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"userId\", json.id);",
                  "} else if (pm.response.code === 409) {",
                  "    // User already exists. If userId is not set yet, fail loudly so it is fixed explicitly.",
                  "    if (!pm.collectionVariables.get(\"userId\")) {",
                  "        pm.test(\"userId must be preset when 409 returned\", function () {",
                  "            throw new Error(\"userId collection variable is not set while user already exists\");",
                  "        });",
                  "    }",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
